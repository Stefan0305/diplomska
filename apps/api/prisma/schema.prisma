generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  /// Stored lowercased (normalized by the shared Zod schema).
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  projects     Project[]
  models       Model[]
}

/// A GLB in the model library. Native dimensions are not stored: the editor measures them.
model Model {
  id        String   @id @default(cuid())
  /// null = built-in model, visible to everyone and not deletable.
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// One of the shared modelCategories (SQLite has no enums; validated by Zod).
  category  String
  /// Relative to its root: apps/api/assets/models/ for built-ins, the uploads folder otherwise.
  filePath  String   @unique
  fileSize  Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Project {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  /// Serialized JSON validated by the shared sceneSchema; never queried by contents.
  scene      String
  /// Relative path of the thumbnail image under the uploads folder (Sprint 6).
  thumbnail  String?
  /// Set while the project is shared read-only (Sprint 7).
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId, updatedAt])
}
